{
  "$defs": {
    "AnswerCaveat": {
      "additionalProperties": false,
      "description": "Required semantic caveat represented by controlled codes only.",
      "properties": {
        "caveat_code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Caveat Code",
          "type": "string"
        },
        "caveat_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Caveat Id",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Evidence Ids",
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "related_claim_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Related Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "caveat_id",
        "caveat_code",
        "reason_codes"
      ],
      "title": "AnswerCaveat",
      "type": "object"
    },
    "AnswerClaimPlan": {
      "additionalProperties": false,
      "description": "Planned claim shape that must exactly match an allowed evidence claim.",
      "properties": {
        "claim_code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Claim Code",
          "type": "string"
        },
        "claim_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Claim Type",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "subject": {
          "$ref": "#/$defs/EvidenceSubjectRef"
        },
        "supporting_fact_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Supporting Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "claim_code",
        "claim_type",
        "subject",
        "supporting_fact_ids",
        "evidence_ids"
      ],
      "title": "AnswerClaimPlan",
      "type": "object"
    },
    "AnswerLengthBudget": {
      "additionalProperties": false,
      "description": "Hard structural output budget for one response.",
      "properties": {
        "max_caveats": {
          "maximum": 32,
          "minimum": 0,
          "title": "Max Caveats",
          "type": "integer"
        },
        "max_characters": {
          "maximum": 16000,
          "minimum": 1,
          "title": "Max Characters",
          "type": "integer"
        },
        "max_citations": {
          "maximum": 64,
          "minimum": 0,
          "title": "Max Citations",
          "type": "integer"
        },
        "max_claims": {
          "maximum": 32,
          "minimum": 0,
          "title": "Max Claims",
          "type": "integer"
        },
        "max_sections": {
          "maximum": 8,
          "minimum": 1,
          "title": "Max Sections",
          "type": "integer"
        }
      },
      "required": [
        "max_characters",
        "max_sections",
        "max_claims",
        "max_caveats",
        "max_citations"
      ],
      "title": "AnswerLengthBudget",
      "type": "object"
    },
    "AnswerSection": {
      "additionalProperties": false,
      "description": "One ordered presentation section referencing claims and caveats.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/AnswerSectionItemRef"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "section_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Section Id",
          "type": "string"
        },
        "section_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Section Type",
          "type": "string"
        }
      },
      "required": [
        "section_id",
        "section_type",
        "items"
      ],
      "title": "AnswerSection",
      "type": "object"
    },
    "AnswerSectionItemRef": {
      "additionalProperties": false,
      "description": "Reference to one planned claim or required caveat within a section.",
      "properties": {
        "item_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Item Id",
          "type": "string"
        },
        "item_kind": {
          "enum": [
            "claim",
            "caveat"
          ],
          "title": "Item Kind",
          "type": "string"
        }
      },
      "required": [
        "item_kind",
        "item_id"
      ],
      "title": "AnswerSectionItemRef",
      "type": "object"
    },
    "AnswerToneConstraints": {
      "additionalProperties": false,
      "description": "Controlled linguistic presentation constraints for one response.",
      "properties": {
        "response_locale": {
          "maxLength": 35,
          "minLength": 2,
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
          "title": "Response Locale",
          "type": "string"
        },
        "tone_codes": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Tone Codes",
          "type": "array"
        }
      },
      "required": [
        "response_locale",
        "tone_codes"
      ],
      "title": "AnswerToneConstraints",
      "type": "object"
    },
    "CitationSlot": {
      "additionalProperties": false,
      "description": "Authorization to place a citation, without any rendered citation.",
      "properties": {
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "placement": {
          "enum": [
            "inline",
            "section_end",
            "answer_end"
          ],
          "title": "Placement",
          "type": "string"
        },
        "slot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Slot Id",
          "type": "string"
        },
        "target_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Target Id",
          "type": "string"
        },
        "target_kind": {
          "enum": [
            "claim",
            "caveat"
          ],
          "title": "Target Kind",
          "type": "string"
        }
      },
      "required": [
        "slot_id",
        "target_kind",
        "target_id",
        "evidence_ids",
        "placement"
      ],
      "title": "CitationSlot",
      "type": "object"
    },
    "EvidenceSubjectRef": {
      "additionalProperties": false,
      "description": "Controlled reference to the subject an evidence record describes.",
      "properties": {
        "subject_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Subject Ref",
          "type": "string"
        },
        "subject_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Subject Type",
          "type": "string"
        }
      },
      "required": [
        "subject_type",
        "subject_ref"
      ],
      "title": "EvidenceSubjectRef",
      "type": "object"
    }
  },
  "$id": "urn:ai-assistant:contracts:answer-plan:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic, validated semantic plan for exactly one response.",
  "properties": {
    "answer_plan_builder_version": {
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Answer Plan Builder Version",
      "type": "string"
    },
    "answer_plan_id": {
      "format": "uuid",
      "title": "Answer Plan Id",
      "type": "string"
    },
    "answer_type": {
      "enum": [
        "direct",
        "summary",
        "explanation",
        "comparison",
        "procedure",
        "status",
        "eligibility",
        "analytics",
        "composite",
        "clarification",
        "abstention"
      ],
      "title": "Answer Type",
      "type": "string"
    },
    "authorization_decision_id": {
      "format": "uuid",
      "title": "Authorization Decision Id",
      "type": "string"
    },
    "built_at": {
      "format": "date-time",
      "title": "Built At",
      "type": "string"
    },
    "caveats": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AnswerCaveat"
      },
      "maxItems": 32,
      "title": "Caveats",
      "type": "array"
    },
    "citation_slots": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CitationSlot"
      },
      "maxItems": 64,
      "title": "Citation Slots",
      "type": "array"
    },
    "claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AnswerClaimPlan"
      },
      "maxItems": 32,
      "title": "Claims",
      "type": "array"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "decision": {
      "enum": [
        "answer",
        "partial_answer",
        "clarify",
        "abstain"
      ],
      "title": "Decision",
      "type": "string"
    },
    "decision_reason_codes": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Decision Reason Codes",
      "type": "array"
    },
    "evidence_bundle_id": {
      "format": "uuid",
      "title": "Evidence Bundle Id",
      "type": "string"
    },
    "length_budget": {
      "$ref": "#/$defs/AnswerLengthBudget"
    },
    "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
    },
    "prohibited_claim_codes": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Prohibited Claim Codes",
      "type": "array"
    },
    "prohibited_content_codes": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Prohibited Content Codes",
      "type": "array"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "route_decision_id": {
      "format": "uuid",
      "title": "Route Decision Id",
      "type": "string"
    },
    "runtime_snapshot_id": {
      "format": "uuid",
      "title": "Runtime Snapshot Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/AnswerSection"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    },
    "tone_constraints": {
      "$ref": "#/$defs/AnswerToneConstraints"
    }
  },
  "required": [
    "answer_plan_id",
    "request_id",
    "evidence_bundle_id",
    "route_decision_id",
    "plan_id",
    "authorization_decision_id",
    "runtime_snapshot_id",
    "correlation_id",
    "built_at",
    "decision",
    "answer_type",
    "sections",
    "tone_constraints",
    "prohibited_content_codes",
    "decision_reason_codes",
    "length_budget",
    "answer_plan_builder_version"
  ],
  "title": "AnswerPlan",
  "type": "object"
}

    "SqlEvidence": {
      "additionalProperties": false,
      "description": "Normalized evidence produced by governed semantic analytics.",
      "properties": {
        "allowed_uses": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Allowed Uses",
          "type": "array"
        },
        "authority": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Authority",

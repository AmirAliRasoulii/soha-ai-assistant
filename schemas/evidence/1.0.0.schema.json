        "freshness",
        "provenance",
        "allowed_uses",
        "retention_class",
        "supports_fact_ids",
        "selector_ref",
        "result_ref",
        "result_sha256",
        "field_codes"
      ],
      "title": "SelectorEvidence",
      "type": "object"

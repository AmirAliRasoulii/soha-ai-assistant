{
  "$defs": {
    "PlanFactSpec": {
      "additionalProperties": false,
      "description": "Typed declaration of a semantic fact a step must produce.",
      "properties": {
        "data_scope": {
          "enum": [
            "general",
            "personal"
          ],
          "title": "Data Scope",
          "type": "string"
        },
        "fact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Fact Id",
          "type": "string"
        },
        "value_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "value_type",
        "data_scope"
      ],
      "title": "PlanFactSpec",
      "type": "object"
    },
    "PlanInputBinding": {
      "additionalProperties": false,
      "description": "Typed reference describing where a step input comes from.",
      "properties": {
        "data_scope": {
          "enum": [
            "general",
            "personal"
          ],
          "title": "Data Scope",
          "type": "string"
        },
        "input_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Input Name",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "query_analysis",
            "route_decision",
            "runtime_snapshot",
            "approved_artifact",
            "step_output"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Source Ref",
          "type": "string"
        },
        "source_step_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Step Id"
        },
        "value_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "input_name",
        "source_kind",
        "source_ref",
        "value_type",
        "data_scope"
      ],
      "title": "PlanInputBinding",
      "type": "object"
    },
    "PlanParallelGroup": {
      "additionalProperties": false,
      "description": "Execution layer whose steps may run concurrently.",
      "properties": {
        "group_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Group Id",
          "type": "string"
        },
        "step_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Step Ids",
          "type": "array"
        }
      },
      "required": [
        "group_id",
        "step_ids"
      ],
      "title": "PlanParallelGroup",
      "type": "object"
    },
    "PlanStep": {
      "additionalProperties": false,
      "description": "Bounded declaration of one intended capability invocation.",
      "properties": {
        "capability": {
          "enum": [
            "document_retrieval",
            "semantic_analytics",
            "personal_selector",
            "rule_evaluator",
            "official_search"
          ],
          "title": "Capability",
          "type": "string"
        },
        "depends_on": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 4,
          "title": "Depends On",
          "type": "array"
        },
        "input_bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlanInputBinding"
          },
          "maxItems": 16,
          "title": "Input Bindings",
          "type": "array"
        },
        "operation": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Operation",
          "type": "string"
        },
        "produces": {
          "items": {
            "$ref": "#/$defs/PlanFactSpec"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Produces",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "step_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "capability",
        "operation",
        "produces",
        "required"
      ],
      "title": "PlanStep",
      "type": "object"
    },
    "RouteBudget": {
      "additionalProperties": false,
      "description": "Frozen count-based execution limits for a routed turn.",
      "properties": {
        "max_analytics_repairs": {
          "maximum": 1,
          "minimum": 0,
          "title": "Max Analytics Repairs",
          "type": "integer"
        },
        "max_answer_repairs": {
          "maximum": 1,
          "minimum": 0,
          "title": "Max Answer Repairs",
          "type": "integer"
        },
        "max_parallel_steps": {
          "maximum": 3,
          "minimum": 0,
          "title": "Max Parallel Steps",
          "type": "integer"
        },
        "max_replans": {
          "maximum": 1,
          "minimum": 0,
          "title": "Max Replans",
          "type": "integer"
        },
        "max_retrieval_retries": {
          "maximum": 1,
          "minimum": 0,
          "title": "Max Retrieval Retries",
          "type": "integer"
        },
        "max_steps": {
          "maximum": 5,
          "minimum": 0,
          "title": "Max Steps",
          "type": "integer"
        }
      },
      "required": [
        "max_steps",
        "max_parallel_steps",
        "max_replans",
        "max_retrieval_retries",
        "max_analytics_repairs",
        "max_answer_repairs"
      ],
      "title": "RouteBudget",
      "type": "object"
    }
  },
  "$id": "urn:ai-assistant:contracts:execution-plan:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable, bounded description of intended execution for one turn.",
  "properties": {
    "allowed_capabilities": {
      "items": {
        "enum": [
          "document_retrieval",
          "semantic_analytics",
          "personal_selector",
          "rule_evaluator",
          "official_search"
        ],
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Allowed Capabilities",
      "type": "array"
    },
    "authorization_decision_id": {
      "format": "uuid",
      "title": "Authorization Decision Id",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/RouteBudget"
    },
    "composition_type": {
      "enum": [
        "single",
        "sectioned",
        "comparison",
        "rule_join",
        "temporal_join",
        "aggregate"
      ],
      "title": "Composition Type",
      "type": "string"
    },
    "goal": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Goal",
      "type": "string"
    },
    "lane": {
      "enum": [
        "deterministic",
        "fast",
        "composite"
      ],
      "title": "Lane",
      "type": "string"
    },
    "missing_evidence_policy": {
      "enum": [
        "partial",
        "clarify",
        "abstain"
      ],
      "title": "Missing Evidence Policy",
      "type": "string"
    },
    "parallel_groups": {
      "items": {
        "$ref": "#/$defs/PlanParallelGroup"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Parallel Groups",
      "type": "array"
    },
    "parent_plan_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Plan Id"
    },
    "plan_builder_version": {
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Plan Builder Version",
      "type": "string"
    },
    "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
    },
    "planned_at": {
      "format": "date-time",
      "title": "Planned At",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "required_facts": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Required Facts",
      "type": "array"
    },
    "revision": {
      "maximum": 1,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "route_decision_id": {
      "format": "uuid",
      "title": "Route Decision Id",
      "type": "string"
    },
    "runtime_snapshot_id": {
      "format": "uuid",
      "title": "Runtime Snapshot Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/PlanStep"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "success_condition": {
      "const": "all_required_facts",
      "title": "Success Condition",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "request_id",
    "route_decision_id",
    "authorization_decision_id",
    "runtime_snapshot_id",
    "planned_at",
    "lane",
    "goal",
    "allowed_capabilities",
    "required_facts",
    "steps",
    "parallel_groups",
    "composition_type",
    "success_condition",
    "missing_evidence_policy",
    "budget",
    "revision",
    "plan_builder_version"
  ],
  "title": "ExecutionPlan",
  "type": "object"
}

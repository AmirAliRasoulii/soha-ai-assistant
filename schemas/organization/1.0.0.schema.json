{
  "$id": "urn:ai-assistant:contracts:organization:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One tenant organization with exactly one root node.\n\nIsolation between organizations is structural: nothing in this contract can\nexpress a shared node, a shared root, or an inherited relationship across\norganizations.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "display_name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "external_ref": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Ref"
    },
    "organization_id": {
      "format": "uuid",
      "title": "Organization Id",
      "type": "string"
    },
    "root_node_id": {
      "format": "uuid",
      "title": "Root Node Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "non_active"
      ],
      "title": "Status",
      "type": "string"
    },
    "status_changed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status Changed At"
    }
  },
  "required": [
    "organization_id",
    "display_name",
    "status",
    "root_node_id",
    "created_at"
  ],
  "title": "Organization",
  "type": "object"
}

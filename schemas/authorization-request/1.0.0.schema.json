{
  "$defs": {
    "AnonymousGuest": {
      "additionalProperties": false,
      "description": "First-class typed Guest actor (DEF-108).\n\nA Guest is an accepted architecture actor, not a fallback: it is only ever\nconstructed deliberately for an unauthenticated public surface. It carries\nno principal identifier, no role, no membership, and no scope, so nothing\ndownstream can mistake a Guest for a narrowed authenticated principal.",
      "properties": {
        "established_at": {
          "format": "date-time",
          "title": "Established At",
          "type": "string"
        },
        "guest_session_id": {
          "format": "uuid",
          "title": "Guest Session Id",
          "type": "string"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        },
        "visibility_class": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Visibility Class",
          "type": "string"
        }
      },
      "required": [
        "guest_session_id",
        "organization_id",
        "established_at",
        "visibility_class"
      ],
      "title": "AnonymousGuest",
      "type": "object"
    },
    "AuthenticatedPrincipalRef": {
      "additionalProperties": false,
      "description": "Reference to a principal whose identity was already established.\n\nThe trusted identity facts themselves live in `SecurityPrincipalContext\n1.0.0`; this reference only binds a request to that context and to the\norganization the request is made in.",
      "properties": {
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        },
        "principal_id": {
          "format": "uuid",
          "title": "Principal Id",
          "type": "string"
        },
        "security_context_id": {
          "format": "uuid",
          "title": "Security Context Id",
          "type": "string"
        }
      },
      "required": [
        "principal_id",
        "security_context_id",
        "organization_id"
      ],
      "title": "AuthenticatedPrincipalRef",
      "type": "object"
    },
    "AuthorizationResourceRef": {
      "additionalProperties": false,
      "description": "Opaque reference to the resource an authorization decision applies to.",
      "properties": {
        "classification": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Classification"
        },
        "resource_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        },
        "resource_type": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Resource Type",
          "type": "string"
        }
      },
      "required": [
        "resource_type",
        "resource_id"
      ],
      "title": "AuthorizationResourceRef",
      "type": "object"
    },
    "AuthorizationScopeRef": {
      "additionalProperties": false,
      "description": "Explicit set of nodes an assignment or decision applies to.\n\nThe enumeration is exhaustive by construction. There is no descendant,\nsubtree, or wildcard flag, so no consumer of this contract can widen a\nscope by reading it; any breadth beyond these exact nodes must be produced\nby CP-002 policy evaluation and expressed as its own explicit scope value.",
      "properties": {
        "node_refs": {
          "items": {
            "$ref": "#/$defs/OrganizationalNodeRef"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Node Refs",
          "type": "array"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        }
      },
      "required": [
        "organization_id",
        "node_refs"
      ],
      "title": "AuthorizationScopeRef",
      "type": "object"
    },
    "OrganizationalNodeRef": {
      "additionalProperties": false,
      "description": "Opaque reference to exactly one node inside exactly one organization.\n\nThe organization identifier travels with every node reference so that a\ncross-organization relationship is structurally detectable at the contract\nboundary instead of depending on a later lookup.",
      "properties": {
        "node_id": {
          "format": "uuid",
          "title": "Node Id",
          "type": "string"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        }
      },
      "required": [
        "organization_id",
        "node_id"
      ],
      "title": "OrganizationalNodeRef",
      "type": "object"
    },
    "PermissionRef": {
      "additionalProperties": false,
      "description": "Reference to one permission term of the versioned permission catalog.",
      "properties": {
        "catalog_revision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Catalog Revision",
          "type": "string"
        },
        "permission_code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Permission Code",
          "type": "string"
        }
      },
      "required": [
        "permission_code",
        "catalog_revision"
      ],
      "title": "PermissionRef",
      "type": "object"
    },
    "RequestActorContext": {
      "$id": "urn:ai-assistant:contracts:request-actor-context:1.0.0",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "The actor a request is evaluated for: exactly one authenticated principal\nor exactly one Guest.\n\nThe mutually exclusive shape is the invariant: a payload that carries both\nan authenticated principal and a Guest, or neither, is rejected. Combined\nwith the closed `ActorKind`, this makes \"authentication failed, continue as\nGuest\" structurally impossible.",
      "properties": {
        "actor_kind": {
          "enum": [
            "authenticated_principal",
            "anonymous_guest"
          ],
          "title": "Actor Kind",
          "type": "string"
        },
        "authenticated_principal": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthenticatedPrincipalRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "guest": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnonymousGuest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "actor_kind"
      ],
      "title": "RequestActorContext",
      "type": "object"
    }
  },
  "$id": "urn:ai-assistant:contracts:authorization-request:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The exact question put to authorization: actor, action, permission,\nresource, and requested scope, at a stated instant.\n\nThis contract states the question only. It carries no effect, no reason\ncode, and no obligation, so it can never be mistaken for a decision.",
  "properties": {
    "action": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Action",
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/RequestActorContext"
    },
    "deadline_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline At"
    },
    "organization_id": {
      "format": "uuid",
      "title": "Organization Id",
      "type": "string"
    },
    "permission": {
      "$ref": "#/$defs/PermissionRef"
    },
    "request_fingerprint": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "requested_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizationScopeRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "resource": {
      "$ref": "#/$defs/AuthorizationResourceRef"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "organization_id",
    "actor",
    "action",
    "permission",
    "resource",
    "requested_at",
    "request_fingerprint"
  ],
  "title": "AuthorizationRequest",
  "type": "object"
}
